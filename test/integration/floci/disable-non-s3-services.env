# Floci (floci/floci) has no "enable only these services" allowlist — every
# service defaults to enabled and must be disabled individually via
# FLOCI_SERVICES_<NAME>_ENABLED=false (per https://floci.io/floci/configuration/advanced/application-yml/).
# This file disables every service except S3. It was generated from the
# "Enabled services: [...]" line Floci logs on startup with no overrides
# (floci/floci:1.5.28); if a future Floci version adds a service, add its
# disable line here too, or it will be exposed unintentionally.
FLOCI_SERVICES_ACM_ENABLED=false
FLOCI_SERVICES_APIGATEWAY_ENABLED=false
FLOCI_SERVICES_APIGATEWAYV2_ENABLED=false
FLOCI_SERVICES_APPCONFIGDATA_ENABLED=false
